# Local dev only (bun run dev) — docker compose builds its own DATABASE_URL from POSTGRES_* below
DATABASE_URL=postgres://postgres:postgres@localhost:5432/timetracker

# Docker Postgres credentials (docker compose). Only applied when the pgdata volume is first
# created — changing them later won't update an existing database. Use a URL-safe password
# (letters/digits), since it is interpolated into DATABASE_URL.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=timetracker

# Weekly report email (sent every Friday 18:00 in REPORT_TIMEZONE)
REPORT_TIMEZONE=Europe/Bucharest
REPORT_EMAIL_TO=you@example.com
REPORT_EMAIL_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_xxxxxxxxx
