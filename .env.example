# Local dev only (bun run dev) — docker compose builds its own DATABASE_URL from POSTGRES_* below
DATABASE_URL=postgres://postgres:postgres@localhost:5432/timetracker

# Docker Postgres credentials (docker compose). Only applied when the pgdata volume is first
# created — changing them later won't update an existing database. Use a URL-safe password
# (letters/digits), since it is interpolated into DATABASE_URL.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=timetracker

# Report emails: weekly every Friday 18:00, monthly on the last day of the month 18:00 (REPORT_TIMEZONE)
REPORT_TIMEZONE=Europe/Bucharest
REPORT_EMAIL_TO=you@example.com
REPORT_EMAIL_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_xxxxxxxxx

# ── Raspberry Pi only (leave commented out on the Mac) ──
# Adds Caddy with HTTPS + basic auth in front of the app and stops exposing :3100.
# Generate the hash with: docker run --rm -it caddy:2-alpine caddy hash-password
# Keep the single quotes around the hash, otherwise Compose mangles its `$` characters.
# COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml
# SITE_ADDRESS=raspberrypi.local
# BASIC_AUTH_USER=admin
# BASIC_AUTH_HASH='$2a$14$replace-with-output-of-hash-password'
